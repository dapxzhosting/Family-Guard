    <style name="Theme.FamilyGuard.LockScreen" parent="Theme.MaterialComponents.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorPrimary">@color/dash_child_primary</item>
        <item name="colorPrimaryVariant">@color/dash_child_primary_dark</item>
