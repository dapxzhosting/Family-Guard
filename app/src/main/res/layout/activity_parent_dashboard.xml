<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ HEADER ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_shield"
                        app:tint="#FFFFFF"
                        android:contentDescription="FamilyGuard" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="FamilyGuard"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Chip status koneksi ringkas di pojok header -->
                    <LinearLayout
                        android:id="@+id/chipHeaderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_family_code_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <View
                            android:id="@+id/dotHeaderStatus"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_offline" />

                        <TextView
                            android:id="@+id/tvHeaderStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Memuat"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="KODE KELUARGA"
                    android:textColor="#99AAFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_family_code_chip"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tvFamilyCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ PILIH ANAK (kalau lebih dari 1 HP anak) ============ -->
            <LinearLayout
                android:id="@+id/layoutChildSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih HP anak"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerChildSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ============ KONTEN ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp">

                <!-- Kartu Status Perangkat -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_divider"
                    app:cardBackgroundColor="@color/dash_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <View
                            android:id="@+id/dotDeviceStatus"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/dot_offline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status HP Anak"
                                android:textColor="@color/dash_text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDeviceStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Memuat..."
                                android:textColor="@color/dash_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Aksi Cepat -->
                <TextView
                    style="@style/DashSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Aksi Cepat" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_divider"
                    app:cardBackgroundColor="@color/dash_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="18dp"
                        android:paddingBottom="14dp">

                        <!-- Aksi Cepat: pakai MaterialButton asli (2x2 grid), lebih
                             reliable ditekan daripada tile custom, karena widget bawaan
                             Android sudah punya touch-handling teruji, tanpa perlu
                             workaround requestDisallowInterceptTouchEvent segala. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLockScreen"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="Kunci Layar"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:enabled="false"
                                app:icon="@drawable/ic_lock"
                                app:iconGravity="textStart"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:backgroundTint="@color/dash_danger"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUnlockScreen"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="Buka Kunci"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:enabled="false"
                                app:icon="@drawable/ic_unlock"
                                app:iconGravity="textStart"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:backgroundTint="@color/dash_success"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSendMessage"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="Kirim Pesan"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:enabled="false"
                                app:icon="@drawable/ic_message"
                                app:iconGravity="textStart"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:backgroundTint="@color/dash_info"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSetPin"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="Atur PIN"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:enabled="false"
                                app:icon="@drawable/ic_key"
                                app:iconGravity="textStart"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:backgroundTint="@color/dash_purple"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="4dp"
                            android:background="@color/dash_divider" />

                        <!-- Lihat dan Kontrol Layar, aksi utama, dibuat menonjol -->
                        <LinearLayout
                            android:id="@+id/btnViewScreen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_action_highlight"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_circle_purple">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_phone_screen"
                                    app:tint="@color/dash_purple"
                                    android:contentDescription="Lihat Layar" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Lihat &amp; Kontrol Layar"
                                    android:textColor="@color/dash_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Pantau layar HP anak secara real-time"
                                    android:textColor="@color/dash_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/dash_purple"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lokasi -->
                <TextView
                    style="@style/DashSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Lokasi Terakhir" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_divider"
                    app:cardBackgroundColor="@color/dash_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_circle_info">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_location_pin"
                                    app:tint="@color/dash_info"
                                    android:contentDescription="Lokasi" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Mencari lokasi..."
                                android:textColor="@color/dash_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <org.osmdroid.views.MapView
                            android:id="@+id/mapView"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="14dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenMap"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Lihat Peta Full Layar"
                            android:textAllCaps="false"
                            android:textColor="@color/dash_primary"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/dash_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Aplikasi HP Anak -->
                <TextView
                    style="@style/DashSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Aplikasi HP Anak" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_divider"
                    app:cardBackgroundColor="@color/dash_surface">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvChildApps"
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clipToPadding="false" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Lainnya -->
                <TextView
                    style="@style/DashSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Lainnya" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_divider"
                    app:cardBackgroundColor="@color/dash_surface">

                    <LinearLayout
                        android:id="@+id/btnResetRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reset Role (Logout)"
                            android:textColor="@color/dash_danger"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_logout"
                            app:tint="@color/dash_danger"
                            android:contentDescription="Reset Role" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>