<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dash_surface"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:contentDescription="Kembali" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Kebijakan &amp; Ketentuan"
            android:textColor="@color/dash_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kebijakan Privasi &amp; Syarat Layanan"
                android:textColor="@color/dash_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terakhir diperbarui: 28 Agustus 2026"
                android:textColor="@color/dash_text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="24dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Pendahuluan"
                android:textColor="@color/dash_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selamat datang di FamilyGuard. Aplikasi ini dirancang khusus untuk membantu orang tua dalam mendampingi dan melindungi aktivitas digital anak. Dengan menggunakan aplikasi ini, Anda menyetujui pengumpulan dan penggunaan informasi sesuai dengan kebijakan ini."
                android:textColor="@color/dash_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Penggunaan Izin Khusus &amp; Sensitif"
                android:textColor="@color/dash_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FamilyGuard memerlukan beberapa izin khusus agar fungsi perlindungan berjalan optimal:\n\n• Layanan Aksesibilitas (Accessibility Service): Digunakan untuk mendeteksi aplikasi yang dibuka di perangkat anak dan melakukan pemblokiran sesuai aturan yang ditetapkan orang tua.\n• Lokasi (Location): Digunakan untuk menampilkan posisi real-time anak demi keselamatan keluarga.\n• MediaProjection / Screen Capture: Digunakan untuk fitur pemantauan tampilan layar atas izin pengguna.\n• Pengelola Perangkat (Device Admin): Digunakan untuk mencegah aplikasi dicopot (uninstall) tanpa seizin orang tua."
                android:textColor="@color/dash_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Keamanan &amp; Kerahasiaan Data"
                android:textColor="@color/dash_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kami sangat menjaga privasi keluarga Anda. Data lokasi dan aktivitas dienkripsi dan hanya disinkronkan ke akun orang tua yang terhubung melalui kode keluarga unik. Data Anda tidak akan pernah dijual atau dibagikan kepada pihak ketiga untuk kepentingan iklan."
                android:textColor="@color/dash_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Syarat &amp; Ketentuan Penggunaan"
                android:textColor="@color/dash_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aplikasi ini wajib diinstal atas sepengetahuan dan persetujuan wali/orang tua dan anak. Penggunaan aplikasi untuk memantau perangkat individu dewasa tanpa izin eksplisit adalah pelanggaran hukum dan syarat penggunaan."
                android:textColor="@color/dash_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/dash_surface"
        android:elevation="8dp"
        android:padding="16dp">
        <Button
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Saya Mengerti &amp; Setuju"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
