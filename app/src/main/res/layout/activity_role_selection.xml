<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnRoleSelectionBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_right"
        android:rotation="180"
        android:contentDescription="Kembali"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#1A237E" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FamilyGuard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_shield"
        android:drawableTint="#1A237E"
        android:drawablePadding="8dp"
        android:gravity="center_vertical" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp"
        android:text="HP ini dipakai sebagai apa?"
        android:textSize="15sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnRoleParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Saya Orang Tua\nPantau &amp; kendalikan HP anak"
        android:textAlignment="center" />

    <Button
        android:id="@+id/btnRoleChild"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:text="Ini HP Anak\nPasang perlindungan di HP ini"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Pilihan ini tidak bisa diubah nanti tanpa reset app"
        android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
