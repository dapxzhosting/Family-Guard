<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/dash_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/actionIconCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_member_avatar">

            <ImageView
                android:id="@+id/ivActionIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Aksi" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvActionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Judul"
            android:textColor="@color/dash_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pesan"
            android:textColor="@color/dash_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilActionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etActionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dash_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnActionCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Batal"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp"
                android:textColor="@color/dash_white"
                android:backgroundTint="@color/dash_divider"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnActionConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Ya"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp"
                android:textColor="@color/dash_white"
                android:backgroundTint="@color/dash_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
