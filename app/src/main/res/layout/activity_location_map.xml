<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg">
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/dash_primary">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/dash_white"
                android:contentDescription="Kembali" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lokasi HP Anak"
                    android:textColor="@color/dash_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_pin_location"
                    android:drawableTint="@color/dash_white"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />
                <TextView
                    android:id="@+id/tvLastUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menunggu data lokasi..."
                    android:textColor="@color/dash_info_text_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCoords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/dash_surface">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/skeletonCoords"
                    android:layout_width="150dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_skeleton_block" />
                <TextView
                    android:id="@+id/tvCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Koordinat: —"
                    android:textColor="@color/dash_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
            </FrameLayout>
            <Button
                android:id="@+id/btnRecenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/dash_info"
                android:text="Pusatkan ke Lokasi Anak"
                android:textColor="@color/dash_white"
                android:drawableStart="@drawable/ic_target"
                android:drawableTint="@color/dash_white"
                android:drawablePadding="8dp" />
            <Button
                android:id="@+id/btnOpenExternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/dash_child_primary"
                android:text="Buka di Aplikasi Peta Lain"
                android:textColor="@color/dash_white"
                android:drawableStart="@drawable/ic_map"
                android:drawableTint="@color/dash_white"
                android:drawablePadding="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
