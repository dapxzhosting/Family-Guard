<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00695C"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Terkunci"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aplikasi Dikunci"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Masukkan PIN orang tua untuk membuka"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- Kotak PIN bergaya titik-titik (seperti input PIN asli).
             FrameLayout menumpuk: EditText transparan (nangkep ketikan +
             keyboard) DI ATAS baris titik-titik dekoratif. Tap di mana saja
             di area ini tetap fokus ke EditText yang tersembunyi. -->
        <FrameLayout
            android:id="@+id/pinInputArea"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/pin_box_background">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/pin_dot_empty" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/pin_dot_empty" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/pin_dot_empty" />

                <View
                    android:id="@+id/dot4"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/pin_dot_empty" />

                <View
                    android:id="@+id/dot5"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/pin_dot_empty" />

                <View
                    android:id="@+id/dot6"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/pin_dot_empty" />

            </LinearLayout>

            <!-- EditText asli: transparan total (teks & cursor tak terlihat),
                 tapi tetap yang benar-benar menangkap input & memunculkan
                 keyboard. Dibuat menutupi seluruh area supaya tap di mana pun
                 di kotak PIN langsung fokus ke sini. -->
            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:imeOptions="actionDone"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@android:color/transparent"
                android:textCursorDrawable="@null"
                android:textSize="1sp" />

        </FrameLayout>

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#4CAF50"
            android:elevation="2dp"
            android:letterSpacing="0.02"
            android:text="Buka Aplikasi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Kembali ke Home"
            android:textAllCaps="false"
            android:textColor="#90A4AE"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>
</ScrollView>