<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_black"
    android:fitsSystemWindows="false">

    <!-- Video mirror: benar-benar full screen, edge-to-edge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/rendererScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <!-- Top bar: overlay transparan di atas video, tidak memakan ruang video -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#B3000000">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Layar HP Anak"
            app:titleTextColor="@color/dash_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Menyambungkan…"
                android:textColor="@color/dash_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Mode Kontrol"
                    android:textColor="@color/dash_white"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchControlMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Control bar: overlay transparan di bawah video, muncul saat Mode Kontrol aktif -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnRemotePower"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Power"
            android:padding="10dp"
            android:src="@drawable/ic_power"
            app:tint="@color/dash_white" />

        <ImageButton
            android:id="@+id/btnRemoteVolumeDown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Volume Turun"
            android:padding="10dp"
            android:src="@drawable/ic_volume_down"
            app:tint="@color/dash_white" />

        <ImageButton
            android:id="@+id/btnRemoteVolumeUp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Volume Naik"
            android:padding="10dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/dash_white" />

        <ImageButton
            android:id="@+id/btnRemoteBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Kembali"
            android:padding="10dp"
            android:src="@drawable/ic_nav_back"
            app:tint="@color/dash_white" />

        <ImageButton
            android:id="@+id/btnRemoteHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Home"
            android:padding="10dp"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/dash_white" />

        <ImageButton
            android:id="@+id/btnRemoteRecents"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Aplikasi Terkini"
            android:padding="10dp"
            android:src="@drawable/ic_nav_recents"
            app:tint="@color/dash_white" />

    </LinearLayout>

    <!-- Tombol kecil untuk sembunyikan/tampilkan overlay, biar status bar & area atas HP anak
         tidak ketutup permanen dan lebih gampang dikontrol -->
    <ImageButton
        android:id="@+id/btnToggleOverlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_control_button"
        android:contentDescription="Sembunyikan/tampilkan menu"
        android:padding="7dp"
        android:src="@drawable/ic_eye_off"
        app:tint="@color/dash_white" />

</FrameLayout>