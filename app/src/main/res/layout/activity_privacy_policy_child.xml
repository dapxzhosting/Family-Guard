<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FBFA">

    <!-- Top Toolbar / Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:contentDescription="Kembali" />

        <TextView
            android:fontFamily="sans-serif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Kebijakan &amp; Ketentuan"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Content Area (Scrollable) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kebijakan Privasi buat Kamu"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terakhir diperbarui: 28 Agustus 2026"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:layout_marginBottom="24dp" />

            <!-- Section 1 -->
            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Apa itu FamilyGuard?"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FamilyGuard adalah aplikasi yang dipasang orang tua atau wali kamu di HP ini. Tujuannya bukan untuk menghukum atau mengintip diam-diam, tapi untuk membantu menjaga kamu tetap aman saat menggunakan HP dan internet."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Section 2 -->
            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Apa yang Bisa Dilihat Orang Tua?"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Supaya kamu tidak kaget, ini hal-hal yang bisa dilihat orang tua kamu lewat aplikasi ini:\n\n• Lokasi kamu, supaya mereka tahu kamu aman.\n• Aplikasi apa saja yang kamu buka di HP ini.\n• Berapa lama kamu memakai tiap aplikasi (screen time).\n• Tampilan layar HP kamu, HANYA kalau fitur ini diaktifkan oleh orang tua.\n\nSemua ini hanya bisa dilihat oleh orang tua/wali yang terhubung ke akun keluarga kamu, bukan orang lain."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Section 3 -->
            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Kenapa Ini Penting?"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Internet itu luas dan kadang ada hal-hal yang belum cocok untuk usia kamu. FamilyGuard membantu orang tua mendampingi kamu, bukan untuk membatasi kamu tanpa alasan. Kalau ada aturan yang menurut kamu kurang pas, bicarakan langsung dengan orang tua kamu ya."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Section 4 -->
            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Data Kamu Aman"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data kamu (lokasi, aktivitas aplikasi, dll) dienkripsi dan hanya tersambung ke akun keluarga kamu lewat kode keluarga. Data ini tidak dijual, tidak dibagikan ke orang asing, dan tidak dipakai untuk iklan."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Section 5 -->
            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Hak Kamu"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kamu berhak tahu aplikasi ini terpasang di HP kamu (dan sekarang kamu sudah tahu). Kalau kamu punya pertanyaan atau merasa tidak nyaman dengan pengaturan yang ada, kamu boleh dan sebaiknya membicarakannya langsung dengan orang tua atau wali kamu."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:fontFamily="sans-serif"
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Aku Mengerti"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#00695C" />
    </LinearLayout>

</LinearLayout>